{"id": "f21834cf-cc20-4773-be4d-2f21807bd421", "finding_id": null, "source": "odc", "issue_type": "sca", "repo_url": null, "base_ref": null, "rule_id": null, "cve_id": "CVE-2024-4067", "ghsa_id": "GHSA-952P-6RRQ-RCJV", "cwe": [{"id": "CWE-1333", "name": null}], "owasp": [], "severity": "MEDIUM", "confidence": null, "file_path": "scan/package-lock.json?readdirp:2.2.1/micromatch:^3.1.10", "line_range": null, "package_name": "micromatch", "package_version": "3.1.10", "fixed_version": null, "purl": "pkg:npm/micromatch@3.1.10", "ecosystem": "npm", "message": "The NPM package `micromatch` prior to version 4.0.8 is vulnerable to Regular Expression Denial of Service (ReDoS). The vulnerability occurs in `micromatch.braces()` in `index.js` because the pattern `.*` will greedily match anything. By passing a malicious payload, the pattern matching will keep backtracking to the input while it doesn't find the closing bracket. As the input size increases, the consumption time will also increase until it causes the application to hang or slow down. There was a merged fix but further testing shows the issue persisted prior to https://github.com/micromatch/micromatch/pull/266. This issue should be mitigated by using a safe pattern that won't start backtracking the regular expression due to greedy matching.\n", "finding_url": null, "dataflow_trace": null, "validation_profile": null, "raw_payload": {"fileName": "micromatch:3.1.10", "filePath": "/scan/package-lock.json?readdirp:2.2.1/micromatch:^3.1.10", "vulnerability": {"source": "NPM", "name": "GHSA-952p-6rrq-rcjv", "unscored": "true", "severity": "moderate", "cvssv3": {"baseScore": 5.300000190734863, "attackVector": "NETWORK", "attackComplexity": "LOW", "privilegesRequired": "NONE", "userInteraction": "NONE", "scope": "UNCHANGED", "confidentialityImpact": "NONE", "integrityImpact": "NONE", "availabilityImpact": "LOW", "baseSeverity": "MEDIUM", "version": "3.1"}, "cwes": ["CWE-1333"], "description": "The NPM package `micromatch` prior to version 4.0.8 is vulnerable to Regular Expression Denial of Service (ReDoS). The vulnerability occurs in `micromatch.braces()` in `index.js` because the pattern `.*` will greedily match anything. By passing a malicious payload, the pattern matching will keep backtracking to the input while it doesn't find the closing bracket. As the input size increases, the consumption time will also increase until it causes the application to hang or slow down. There was a merged fix but further testing shows the issue persisted prior to https://github.com/micromatch/micromatch/pull/266. This issue should be mitigated by using a safe pattern that won't start backtracking the regular expression due to greedy matching.\n", "notes": "", "references": [{"source": "NPM Advisory reference: ", "url": "https://github.com/micromatch/micromatch/blob/2c56a8604b68c1099e7bc0f807ce0865a339747a/index.js#L448", "name": "https://github.com/micromatch/micromatch/blob/2c56a8604b68c1099e7bc0f807ce0865a339747a/index.js#L448"}, {"source": "NPM Advisory reference: ", "url": "https://github.com/micromatch/micromatch/pull/247", "name": "https://github.com/micromatch/micromatch/pull/247"}, {"source": "NPM Advisory reference: ", "url": "https://github.com/micromatch/micromatch/commit/500d5d6f42f0e8dfa1cb5464c6cb420b1b6aaaa0", "name": "https://github.com/micromatch/micromatch/commit/500d5d6f42f0e8dfa1cb5464c6cb420b1b6aaaa0"}, {"source": "NPM Advisory reference: ", "url": "https://github.com/micromatch/micromatch/pull/266", "name": "https://github.com/micromatch/micromatch/pull/266"}, {"source": "NPM Advisory reference: ", "url": "https://devhub.checkmarx.com/cve-details/CVE-2024-4067", "name": "https://devhub.checkmarx.com/cve-details/CVE-2024-4067"}, {"source": "NPM Advisory reference: ", "url": "https://github.com/micromatch/micromatch/releases/tag/4.0.8", "name": "https://github.com/micromatch/micromatch/releases/tag/4.0.8"}, {"source": "NPM Advisory reference: ", "url": "https://github.com/micromatch/micromatch/issues/243", "name": "https://github.com/micromatch/micromatch/issues/243"}, {"source": "NPM Advisory reference: ", "url": "https://github.com/micromatch/micromatch/commit/03aa8052171e878897eee5d7bb2ae0ae83ec2ade", "name": "https://github.com/micromatch/micromatch/commit/03aa8052171e878897eee5d7bb2ae0ae83ec2ade"}, {"source": "NPM Advisory reference: ", "url": "https://nvd.nist.gov/vuln/detail/CVE-2024-4067", "name": "https://nvd.nist.gov/vuln/detail/CVE-2024-4067"}, {"source": "NPM Advisory reference: ", "url": "https://advisory.checkmarx.net/advisory/CVE-2024-4067", "name": "https://advisory.checkmarx.net/advisory/CVE-2024-4067"}, {"source": "NPM Advisory reference: ", "url": "https://github.com/advisories/GHSA-952p-6rrq-rcjv", "name": "https://github.com/advisories/GHSA-952p-6rrq-rcjv"}], "vulnerableSoftware": [{"software": {"id": "cpe:2.3:a:*:micromatch:\\<4.0.8:*:*:*:*:*:*:*"}}]}, "packages": [{"id": "pkg:npm/micromatch@3.1.10", "confidence": "HIGHEST"}], "includedBy": []}, "ingested_at": "2026-08-22T09:47:16.890134+00:00"}
