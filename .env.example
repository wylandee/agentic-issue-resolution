# LLM providers
OPENAI_API_KEY=
REMEDY_LLM_MODEL=gpt-4o-mini
TRIAGE_LLM_ENABLED=false
TRIAGE_LLM_MODEL=gpt-4o-mini
SERPER_API_KEY=

# Optional per-node remediation overrides; unset values fall back to REMEDY_LLM_MODEL.
SUPERVISOR_LLM_MODEL=
UPDATE_LLM_MODEL=
WORKAROUND_LLM_MODEL=
QA_LLM_MODEL=

# Semgrep
SEMGREP_API_TOKEN = "bbbeb46d0c0c1d0ea4fb1c580317dd4bbb22f5704bbed88af5fb93171a770143"
SEMGREP_DEPLOYMENT_SLUG = "mixedberries92_personal_org"

# Dependency-Check and runtime behavior
# Keep arguments shell-parseable; paths are inside the /scan container mount.
ODC_EXTRA_ARGS="--exclude **/*.zip --suppression /scan/suppressions.xml"
REMEDY_BYPASS_WORKAROUND_SUBAGENT=false
REMEDY_DISABLE_POST_QA_TRIAGE=false
REMEDY_DISABLE_RETRIAGE=false

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AppSec-Remediation-Engine
LANGSMITH_ENDPOINT=
REMEDIATION_TRAJECTORY_DIR=

# DeepEval
EVAL_JUDGE_MODEL=gpt-4o-mini