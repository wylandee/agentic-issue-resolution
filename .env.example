# LLM providers
# Required for live worker execution; deterministic fixture preparation can run unset.
OPENAI_API_KEY=
REMEDY_LLM_MODEL=gpt-4o-mini
TRIAGE_LLM_ENABLED=false
TRIAGE_LLM_MODEL=gpt-4o-mini
SERPER_API_KEY=
GITHUB_TOKEN=

# Optional per-node remediation overrides; unset values use REMEDY_LLM_MODEL.
UPDATE_LLM_MODEL=
WORKAROUND_LLM_MODEL=
QA_LLM_MODEL=

# Semgrep
SEMGREP_API_TOKEN = "bbbeb46d0c0c1d0ea4fb1c580317dd4bbb22f5704bbed88af5fb93171a770143"
SEMGREP_DEPLOYMENT_SLUG = "mixedberries92_personal_org"

# Dependency-Check and runtime behavior
# Keep arguments shell-parseable; paths are inside the /scan container mount.
ODC_EXTRA_ARGS="--exclude **/*.zip --suppression /scan/suppressions.xml"
# Set true only when intentionally bypassing workaround-worker dispatch.
REMEDY_BYPASS_WORKAROUND_SUBAGENT=false
# Set true only for runs that intentionally skip Supervisor post-QA triage.
REMEDY_DISABLE_POST_QA_TRIAGE=false
# Development-only guard: leave false in production for an unlimited post-QA budget.
REMEDY_RETRIAGE_LIMIT_ENABLED=false
# Maximum number of post-QA re-triage passes when the guard is enabled.
REMEDY_RETRIAGE_LIMIT=3

# Optional cache, trajectory, and report locations
TRIAGE_CACHE_DIR=
REMEDIATION_TRAJECTORY_DIR=
REMEDIATION_REPORT_DIR=
REMEDIATION_SOLVER_CACHE_DIR="/data/cache/solver"

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AppSec-Remediation-Engine
LANGSMITH_ENDPOINT=

# DeepEval (evaluation commands only)
EVAL_JUDGE_MODEL=gpt-4o-mini
