# ==============================================================================
# Agent Remediation Engine Specific
# ==============================================================================

# Ignore all data files, vector embeddings, and target code clones
/data/clones/*
/data/trajectories/*
/data/reports/*
/data/evals/*
/data/*.csv
/data/*.json
/data/*.jsonl
/data/*.txt
/data/*.db

# Keep the directory structure intact in git
!/data/clones/.gitkeep
!/data/trajectories/.gitkeep
!/data/reports/.gitkeep
!/data/evals/.gitkeep

# Triage enrichment cache (KEV JSON, future EPSS cache)
/data/cache/*
!/data/cache/.gitkeep

# ==============================================================================
# Secrets & Environment Variables (CRITICAL)
# ==============================================================================
.env
.env.*
!.env.example
secrets.yaml

# ==============================================================================
# Python
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/
.env/
env.bak/
venv.bak/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# ==============================================================================
# Testing, Linting & Coverage
# ==============================================================================
.pytest_cache/
.pytest-tmp/
.deepeval/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ==============================================================================
# IDEs & OS
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
# Demo local runtime data and machine-specific files
/demo/.env
/demo/.env.*
!/demo/.env.example
/demo/workspace/
/demo/workspaces/
/demo/data/workspace/
/demo/data/workspaces/
/demo/data/clones/
/demo/data/cache/
/demo/data/reports/
/demo/data/trajectories/
/demo/data/logs/

# Demo frontend/backend generated dependencies and build output
/demo/frontend/node_modules/
/demo/frontend/dist/
/demo/frontend/.vite/
/demo/backend/.venv/
/demo/backend/__pycache__/
/demo/backend/.pytest_cache/